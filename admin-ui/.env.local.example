# Local-dev admin UI config. Copy to .env.local (git-ignored): cp .env.local.example .env.local
# The Keycloak values below match the FIXED local-dev secrets provisioned by
# scripts/bootstrap_keycloak.py — so a fresh checkout works copy-and-go.
# These are local-only and safe to commit; ROTATE for any non-local environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=wallet-platform
KEYCLOAK_CLIENT_ID=admin-ui
KEYCLOAK_CLIENT_SECRET=dev-admin-ui-secret-local-only
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=3f9a1c7e5b2d8046a1c3e5f7091b2d4e
