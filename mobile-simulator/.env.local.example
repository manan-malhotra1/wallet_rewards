# Copy to .env.local. All vars are dev-only — never deploy this app.

# Where the backend is running (the FastAPI app started by `make dev`).
SASAI_BACKEND_URL=http://localhost:8000

# Seeded users. Tenant + phone + PIN are set by `make seed`. The
# default PINs match scripts/seed.py — keep them in sync if you change
# the seed.
SASAI_TENANT_NAME=Sasai-ZA
SASAI_ALICE_PHONE=+27825550001
SASAI_ALICE_PIN=1234
SASAI_BOB_PHONE=+27825550002
SASAI_BOB_PIN=1234
# Agent (cash-in) + airtime merchant (read-only pane). Optional — these default
# to the seeded phones/PINs, so you only need them if you re-seed with others.
SASAI_AGENT_PHONE=+27825558001
SASAI_AGENT_PIN=1234
SASAI_MERCHANT_PHONE=+27825559001
SASAI_MERCHANT_PIN=1234

# Event source secret printed by `make seed`. Used to sign the
# HTTP event-ingestion path. The default value matches scripts/seed.py.
EVENT_SOURCE_KEY=sasai-bank
EVENT_SOURCE_SECRET=dev-simulator-secret-do-not-use-in-prod
