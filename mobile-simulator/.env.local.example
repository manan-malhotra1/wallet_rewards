# Copy to .env.local. All vars are dev-only — never deploy this app.

# Where the backend is running (the FastAPI app started by `make dev`).
SASAI_BACKEND_URL=http://localhost:8000

# Seeded users. Tenant + phone are set by `make seed`. Operators log each user
# in by typing their PIN in the UI — there is no default login PIN. The *_PIN
# vars below are OPTIONAL and unused for auth; they only document the seeded
# default (1234, per scripts/seed.py) as a hint. Leave them unset if you like.
SASAI_TENANT_NAME=Sasai-ZA
SASAI_ALICE_PHONE=+27825550001
SASAI_ALICE_PIN=1234
SASAI_BOB_PHONE=+27825550002
SASAI_BOB_PIN=1234
# Agent, airtime merchant, and cash-in merchant. Optional — these default to the
# seeded phones, so you only need them if you re-seed with different numbers.
SASAI_AGENT_PHONE=+27825558001
SASAI_MERCHANT_PHONE=+27825559001
SASAI_CASHIN_MERCHANT_PHONE=+27825557001

# Event source secret printed by `make seed`. Used to sign the
# HTTP event-ingestion path. The default value matches scripts/seed.py.
EVENT_SOURCE_KEY=sasai-bank
EVENT_SOURCE_SECRET=dev-simulator-secret-do-not-use-in-prod

# Partner external-API key (API-key + HMAC auth) for the "Partner APIs" panel:
# external fund / withdraw / create-user. `make seed` provisions a matching dev
# key with this id + secret; the tenant is derived from the key. Dev-only.
SASAI_API_KEY_ID=sim-dev-key
SASAI_API_KEY_SECRET=dev-external-api-secret-do-not-use-in-prod
