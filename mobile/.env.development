# HTTPS tunnel — reachable from a physical phone over ANY network and avoids
# Android cleartext-to-IP blocks. Quick tunnels are ephemeral (new URL each
# restart); for LAN/emulator you can instead use http://192.168.1.3:8000 (Mac IP)
# or http://10.0.2.2:8000 (emulator).
# Simulator: localhost reaches the Mac directly. For a physical phone, swap in
# the LAN IP (check `ipconfig getifaddr en0`) or a fresh cloudflared tunnel URL.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Card-load SIMULATOR (dev only) — partner key for /api/v1/external/fund.
